<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9"><world name="rcauto_track">
<gravity>0 0 -9.81</gravity>
<physics name="default" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin>
<scene><ambient>0.8 0.8 0.8 1</ambient><background>0.08 0.07 0.10 1</background></scene>
<light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>1 1 1 1</diffuse>
<specular>0.1 0.1 0.1 1</specular><direction>-0.3 -0.3 -1</direction><cast_shadows>false</cast_shadows></light>
<include><uri>model://ksti2026_arena</uri><name>ksti2026_arena</name></include>
<include><uri>model://rcauto_350x200</uri><name>rcauto</name>
<pose>0 -2.919027 0 0 0 3.134082</pose></include>
<model name="arena_overview"><static>true</static>
<link name="camera_mount"><pose>0 0 8 0 1.570796326795 1.570796326795</pose>
<sensor name="top_down" type="camera"><always_on>true</always_on><update_rate>2</update_rate>
<topic>/rcauto/arena/overview</topic>
<camera><horizontal_fov>0.8</horizontal_fov><image><width>480</width><height>600</height><format>R8G8B8</format></image>
<clip><near>0.1</near><far>25</far></clip></camera>
</sensor></link></model>
</world></sdf>
